@echo off
chcp 65001 >nul
title DeepSeek Harness Web (alpha.2 + token)
setlocal

set "NODE_USE_ENV_PROXY=1"
set "HTTPS_PROXY=http://127.0.0.1:7897"
set "HTTP_PROXY=http://127.0.0.1:7897"
set "DSH_HOME=C:\Users\MVT\.dsh"
cd /d "C:\Users\MVT\.dsh"
set "TOKEN_LOG=C:\Users\MVT\.dsh\dsh-web-auth.log"
set "TOKEN_ERR=C:\Users\MVT\.dsh\dsh-web-auth.err"
rem 清理旧日志（每次启动都是新 token）
if exist "%TOKEN_LOG%" del /q "%TOKEN_LOG%"

rem 如果 3080 已在跑：直接从日志读 token 开浏览器
netstat -an | findstr /r /c:":3080 .*LISTENING" >nul 2>&1
if not errorlevel 1 goto :open_from_log

echo Starting dsh web on port 3080...
start "DSH-3080" /min cmd /c "node "C:\Program Files\nodejs\node_modules\@deepseek-ai\dsh\lib\bin.js" --profile web --port 3080 --no-open 1> "%TOKEN_LOG%" 2> "%TOKEN_ERR%""

:wait_token
timeout /t 2 /nobreak >nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=(Get-Content '%TOKEN_LOG%' -Raw -ErrorAction SilentlyContinue); $m=[regex]::Match($t,'http://127.0.0.1:3080/\?token=[^\s``\"]+'); if($m.Success){ Start-Process $m.Value; exit 0 } ; exit 1"
for /l %%i in (1,1,30) do (
    netstat -an | findstr /r /c:":3080 .*LISTENING" >nul 2>&1
    if errorlevel 1 goto :wait_token
    exit /b 0
)

:open_from_log
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=(Get-Content '%TOKEN_LOG%' -Raw -ErrorAction SilentlyContinue); $m=[regex]::Match($t,'http://127.0.0.1:3080/\?token=[^\s``\"]+'); if($m.Success){ Start-Process $m.Value; exit 0 }; Write-Host 'no token in log'; exit 1"
exit /b 0
endlocal
